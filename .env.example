# Copy to .env and fill in. Never commit .env.
# The library, tests and replay need none of these.

# Composio developer-platform Project API key (starts with ak_, not ck_)
COMPOSIO_API_KEY=
OPENROUTER_API_KEY=

# Model that drafts the guide, and the one tried if it fails. A default list of
# other free models is tried after these. Free models change; check
# https://openrouter.ai/collections/free-models if both stop working.
EXTRACTION_MODEL=nvidia/nemotron-3.5-super-vl:free
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Or set the whole list yourself, comma-separated:
# EXTRACTION_MODELS=nvidia/nemotron-3.5-super-vl:free,thinkingmachines/inkling:free
# Cap on the model's thinking, so it leaves room for the reply
REASONING_MAX_TOKENS=4000

# Support judge: auto | laya | llm | none
#   auto = Laya if installed, else a free OpenRouter model (SUPPORT_MODELS)
# SUPPORT_MODELS=thinkingmachines/inkling:free,dots-studio/dots-3-note-preview:free
SUPPORT_BACKEND=auto
# Minimum probability of "supports" for a claim to pass
SUPPORT_THRESHOLD=0.75
# LAYA_MODEL=convaiinnovations/laya
